rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == 'landrymouns@gmail.com');
    }

    // Public collections (read-only for everyone, write for admins)
    match /product/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /category/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /pack/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /blog_post/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /promo_event/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /lookbook_post/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /city/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /review/{docId} { allow read: if true; allow create: if isAuthenticated(); allow update, delete: if isAdmin(); }

    // Admin-only collections (sensitive data)
    match /log/{docId} { allow read: if isAdmin(); allow create: if true; allow update, delete: if isAdmin(); }
    match /login_log/{docId} { allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); allow create: if true; allow update, delete: if isAdmin(); }
    match /request_log/{docId} { allow read: if isAdmin(); allow create: if true; allow update, delete: if isAdmin(); }
    match /expense/{docId} { allow read, write: if isAdmin(); }
    match /sales_data/{docId} { allow read, write: if isAdmin(); }
    match /site_config/{docId} { allow read: if true; allow write: if isAdmin(); } // Read needed for frontend
    match /currency/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /coupon/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /notification/{docId} { allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin(); allow write: if isAdmin(); }
    match /invoice/{docId} { allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); allow write: if isAdmin(); }
    match /badge/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /user_profile/{docId} { allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); allow write: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); }
    match /rma/{docId} { allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; allow update, delete: if isAdmin(); }
    match /community_post/{docId} { allow read: if true; allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); }
    match /knitting_project/{docId} { allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid); }

    // Users collection
    match /user/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Prevent privilege escalation: users can't set their own role to admin
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer' || isAdmin());
      allow update: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders
    match /order/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Chat Messages
    match /chat_message/{messageId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // Conversations
    match /conversation/{convId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Default deny for any other collection, but allow admin access
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
