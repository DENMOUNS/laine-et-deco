{
  "entities": {
    "product": {
      "title": "Product",
      "description": "E-commerce product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "price", "category"]
    },
    "category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["name"]
    },
    "order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["userId", "totalAmount"]
    },
    "chat_message": {
      "title": "ChatMessage",
      "description": "Chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["senderId", "senderName", "text", "timestamp"]
    },
    "log": {
      "title": "Log",
      "description": "System log entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "statusCode": { "type": "number" },
        "duration": { "type": "number" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "timestamp": { "type": "string" },
        "ip": { "type": "string" }
      },
      "required": ["method", "path", "timestamp"]
    },
    "custom_order": {
      "title": "CustomOrder",
      "description": "Bespoke project request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "email": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["userId", "description", "status"]
    },
    "city": {
      "title": "City",
      "description": "Cameroon city for delivery pricing",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "deliveryPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["name", "slug", "deliveryPrice", "status"]
    },
    "nav_item": {
      "title": "NavItem",
      "description": "Navigation bar item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "view": { "type": "string" },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["name", "view", "order"]
    },
    "faq": {
      "title": "FAQ",
      "description": "Frequently Asked Question",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["question", "answer", "category"]
    },
    "promo_event": {
      "title": "PromoEvent",
      "description": "Sales or promotional event",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "scheduled", "expired"] }
      },
      "required": ["name", "startDate", "endDate", "discountPercentage", "status"]
    },
    "badge": {
      "title": "Badge",
      "description": "Customer achievement badge",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "unlocked": { "type": "boolean" }
      },
      "required": ["name", "icon", "description", "unlocked"]
    },
    "community_post": {
      "title": "CommunityPost",
      "description": "User shared content",
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "userImage": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "likes": { "type": "number" }
      },
      "required": ["userName", "image", "description"]
    },
    "coupon": {
      "title": "Coupon",
      "description": "Discount coupon",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discount": { "type": "number" },
        "type": { "type": "string", "enum": ["percentage", "fixed", "free_shipping"] },
        "expiryDate": { "type": "string" },
        "usageLimit": { "type": "number" },
        "usageCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "restrictedToUserId": { "type": "string" },
        "freeShipping": { "type": "boolean" }
      },
      "required": ["code", "discount", "type", "expiryDate", "status"]
    },
    "blog_post": {
      "title": "BlogPost",
      "description": "Editorial content",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "pack": {
      "title": "Pack",
      "description": "Product bundle or pack",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["name", "price"]
    },
    "flash_sale": {
      "title": "FlashSale",
      "description": "Timed promotional event",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "items": { "type": "array" }
      },
      "required": ["name", "endDate", "status"]
    },
    "lookbook": {
      "title": "Lookbook",
      "description": "Style guide or collection showcase",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "products": { "type": "array" }
      },
      "required": ["title", "image", "status"]
    },
    "lookbook_post": {
      "title": "LookbookPost",
      "description": "Single item in a lookbook",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "products": { "type": "array" }
      },
      "required": ["title", "image"]
    },
    "site_config": {
      "title": "SiteConfig",
      "description": "General application settings",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "object" }
      },
      "required": ["key", "value"]
    },
    "analytics": {
      "title": "Analytics",
      "description": "Visitor and usage statistics",
      "type": "object",
      "properties": {
        "count": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "product": { "schema": "product", "description": "Products collection" },
    "category": { "schema": "category", "description": "Categories collection" },
    "order": { "schema": "order", "description": "Orders collection" },
    "user": { "schema": "user", "description": "Users collection" },
    "blog_post": { "schema": "blog_post", "description": "Blog posts" },
    "pack": { "schema": "pack", "description": "Product packs" },
    "site_config": { "schema": "site_config", "description": "Site configuration" },
    "flash_sale": { "schema": "flash_sale", "description": "Flash sales collection" },
    "lookbook": { "schema": "lookbook", "description": "Lookbooks collection" },
    "lookbook_post": { "schema": "lookbook_post", "description": "Lookbook posts collection" },
    "chat_message": { "schema": "chat_message", "description": "Chat messages collection" },
    "log": { "schema": "log", "description": "System logs collection" },
    "custom_order": { "schema": "custom_order", "description": "Custom orders collection" },
    "city": { "schema": "city", "description": "Cities and delivery prices collection" },
    "nav_item": { "schema": "nav_item", "description": "Navigation menu items" },
    "faq": { "schema": "faq", "description": "Foire Aux Questions collection" },
    "promo_event": { "schema": "promo_event", "description": "Promo events collection" },
    "badge": { "schema": "badge", "description": "Badges collection" },
    "community_post": { "schema": "community_post", "description": "Community posts collection" },
    "coupon": { "schema": "coupon", "description": "Discount coupons collection" },
    "analytics": { "schema": "analytics", "description": "Global analytics and visitor counts" }
  }
}
