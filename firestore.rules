rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'lmFy8saTupTa8Lmk0oOGSxfPgc13' ||
        (('email' in request.auth.token) && request.auth.token.email == 'landrymoutongo97@gmail.com')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/user/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role in ['admin', 'super-admin', 'editor', 'support-client', 'stock-manager']
      ); 
    }

    // ==========================================
    // ADMINS CAN DO ANYTHING, ANYWHERE
    // ==========================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // PUBLIC READABLE COLLECTIONS
    // ==========================================
    match /product/{docId} { allow read: if true; }
    match /category/{docId} { allow read: if true; }
    match /site_config/{docId} { allow read: if true; }
    match /nav_item/{docId} { allow read: if true; }
    match /faq/{docId} { allow read: if true; }
    match /city/{docId} { allow read: if true; }
    match /promo_event/{docId} { allow read: if true; }
    match /blog_post/{docId} { allow read: if true; }
    match /lookbook_post/{docId} { allow read: if true; }
    match /currency/{docId} { allow read: if true; }
    match /badge/{docId} { allow read: if true; }
    match /pack/{docId} { allow read: if true; }
    match /catalog_price_rule/{docId} { allow read: if true; }
    match /settings/{docId} { allow read: if true; }
    match /member_portfolio/{docId} { allow read: if true; }

    match /coupon/{docId} { 
      allow read: if true; 
      allow update: if (
        // Allow anyone to increment usageCount during checkout
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'updatedAt']) &&
        request.resource.data.usageCount == resource.data.usageCount + 1
      );
    }

    match /review/{docId} { 
      allow read: if true; 
      allow create: if isSignedIn(); 
    }

    match /community_post/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // USER-OWNED COLLECTIONS (Clients can manage their own data)
    // ==========================================
    match /user/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /order/{docId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /custom_pack/{docId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /ticket/{docId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /wishlist/{docId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    match /message/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /chat_message/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /conversation/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
